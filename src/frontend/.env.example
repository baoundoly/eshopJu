# ──────────────────────────────────────────────────────────────────────────────
# EshopJu Frontend — Environment Variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# .env.local is never committed (it is listed in .gitignore).
# Set the same variables as real secrets/values in your CI or deployment
# environment (Vercel project settings, Docker build args, etc.).
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend API ───────────────────────────────────────────────────────────────
# Base URL of the EshopJu .NET API.  Must include /api suffix.
# Defaults to http://localhost:5000/api when this variable is absent.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# International phone number (no + or spaces) for the shop's WhatsApp account.
# Order-confirmation links will open a chat with this number.
NEXT_PUBLIC_WHATSAPP_NUMBER=8801XXXXXXXXX

# ── Site metadata (optional) ──────────────────────────────────────────────────
# Human-readable shop name shown in the browser tab and OG tags.
NEXT_PUBLIC_SITE_NAME=EshopJu

# Canonical public URL of the storefront (no trailing slash).
# Used for absolute OG / SEO URLs when set.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
